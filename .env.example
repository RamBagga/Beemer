# Beemer needs NO secrets. Everything below is optional; defaults shown.
# Copy to .env (gitignored) or set as environment variables / Streamlit secrets on your host.

# Port the web server listens on (Render/Railway/Cloud Run inject this automatically)
PORT=8501

# Where deployed apps download the published data snapshot from (bootstrap.py)
BEEMER_DATA_REPO=RamBagga/Beemer
BEEMER_DATA_TAG=data-latest
# Point at any static host instead (must serve manifest.json, market.db.gz, metrics.parquet):
# BEEMER_DATA_URL=https://example-bucket.r2.dev/beemer

# How often a running app re-checks for a newer snapshot, in hours
BEEMER_DATA_MAX_AGE_HOURS=6

# If no snapshot can be downloaded: full (build everything locally, ~8-10 min, one-off) | none
# (prices = prices only, ~1 min, but most pages need fundamentals - debugging only)
BEEMER_BOOTSTRAP_FALLBACK=full

# Only if the repo is made private: a fine-grained token with read access to Contents
# GITHUB_TOKEN=

# Pipeline: stop calling screener.in after this many consecutive failures
BEEMER_FUND_MAX_FAILS=5
